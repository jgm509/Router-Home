#!/bin/sh
# Router Home: Thread, Bluetooth LE and Zigbee on the Silicon Labs EFR32MG21
# radio of the Askey SBE1V1K / EBE1V1K / CBE1V1K (UART3 = /dev/ttyMSM2).
#
# The radio can run one of three kinds of firmware, found by "iot detect":
#   stock     the router's own multiprotocol firmware (CPC protocol v3,
#             921600 baud, hardware flow control, encrypted after pairing):
#             Thread + Bluetooth LE, through cpcd 4.2, otbr-agent (CPC) and
#             cpc_hci_bridge; from the packages or your own iotkit
#   multipan  a newer multiprotocol build (Simplicity SDK 2025.6 or later, CPC
#             protocol v4+, usually 460800 baud, no flow control, no
#             encryption): Thread + Bluetooth LE + Zigbee, through cpcd 4.9+,
#             otbr-agent (CPC), cpc_hci_bridge and zigbeed
#   rcp       OpenThread RCP (plain Spinel over HDLC, usually 460800): Thread
#             only, through the openthread-br package's otbr-agent
#
#   iot info                          JSON status
#   iot detect                        find the firmware (job)
#   iot install <tar.gz> | remove     your own kit
#   iot pair                          new pairing key (job, stock only)
#   iot apply                         (re)start or stop as configured
#   iot takeover                      move a netifd Thread interface here
#   iot thread-form <name> | thread-join <hex> | thread-leave
#   iot thread-dataset | thread-scan
#   iot ble-scan | ble-adv <on|off>
#   iot services                      what the init script should start
#   iot run-cpcd | run-otbr | run-ble | run-zigbee  (from /etc/init.d/home-ui-iot)
KIT=${KIT:-/usr/lib/iotkit}
ETC=/etc/home-ui/iot
RUN=/tmp/home-ui
TTY=/dev/ttyMSM2
ZPORT=9999
mkdir -p "$RUN" "$ETC"

esc() { printf '%s' "$1" | awk 'BEGIN{ORS=""} {gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/," "); gsub(/\r/,""); gsub(/[\001-\037]/,""); if (NR>1) printf "\\n"; print}'; }
cfg() { uci -q get home-ui-iot.main."$1"; }
on() { [ "$(cfg "$1")" = 1 ]; }
b() { "$@" && echo true || echo false; }

# --- the firmware ----------------------------------------------------------
# $ETC/firmware holds what "detect" found: fw=<kind> baud=<n> flow=<true|false>
# proto=<CPC protocol>; the "firmware" option overrides the kind by hand.
fw=""; baud=""; flow=""; proto=""
[ -s "$ETC/firmware" ] && . "$ETC/firmware"
case "$(cfg firmware)" in
stock) [ "$fw" = stock ] || { fw=stock; baud=921600; flow=true; proto=3; } ;;
multipan) [ "$fw" = multipan ] || { fw=multipan; baud=460800; flow=false; proto=6; } ;;
rcp) [ "$fw" = rcp ] || { fw=rcp; baud=460800; flow=false; proto=""; } ;;
esac
case "$fw" in stock|multipan|rcp) ;; *) fw="" ;; esac
# set up with Router Home 3.1 or older, which only knew the stock firmware
[ -z "$fw" ] && { [ -s "$ETC/binding.key" ] || [ -e "$ETC/noencrypt" ]; } && { fw=stock; baud=921600; flow=true; proto=3; }

# --- the programs ----------------------------------------------------------
# Several builds can be on one router (your stock iotkit for the stock
# firmware, cpcd 4.9 from the packages for multiprotocol, openthread-br for an
# RCP), so each program is chosen by what it can do, not only by name.
# (the kit holds the stock programs: first for the stock firmware, never for
# the others, which they can't talk to; last while detecting)
cands() {
	local d n D="/usr/sbin /usr/bin /usr/lib/multipan/bin"
	case "$fw" in stock) D="$KIT/bin $D" ;; '') D="$D $KIT/bin" ;; esac
	for d in $D; do for n in "$@"; do [ -x "$d/$n" ] && echo "$d/$n"; done; done
}
# run a program, with the kit's libraries if it comes from the kit
x() { case "$1" in "$KIT"/*) LD_LIBRARY_PATH="$KIT/lib" "$@" ;; *) "$@" ;; esac; }
xexec() { case "$1" in "$KIT"/*) LD_LIBRARY_PATH="$KIT/lib" exec "$@" ;; *) exec "$@" ;; esac; }
ver() { x timeout 5 "$1" -v 2>&1 | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' | head -n1; }
vnum() { echo "$1" | awk -F. '{ printf "%d", $1*10000 + $2*100 + $3 }'; }
# cpcd that speaks CPC protocol $1: v3 is cpcd 4.2/4.3, v4+ needs 4.4 or newer
pick_cpcd() {
	local c v n best="" bn=0
	for c in $(cands cpcd); do
		v=$(ver "$c")
		# a kit's cpcd that doesn't print its version is the stock 4.2
		[ -n "$v" ] || case "$c" in "$KIT"/*) v=4.2.0 ;; *) continue ;; esac
		n=$(vnum "$v")
		if [ "${1:-3}" -le 3 ]; then
			[ "$n" -lt 40400 ] && { echo "$c"; return; }
		elif [ "$n" -ge 40400 ] && [ "$n" -gt "$bn" ]; then best=$c; bn=$n; fi
	done
	[ -n "$best" ] && echo "$best"
}
# otbr-agent with the CPC bus (spinel+cpc) or the UART bus (spinel+hdlc)
pick_otbr() { local c; for c in $(cands otbr-agent); do grep -aq "spinel+$1" "$c" && { echo "$c"; return; }; done; }

# the choice is cached: grep over otbr-agent is too slow for every refresh
picks() {
	local key f="$RUN/iot-picks"
	key="$fw $proto $( set -- $(cands cpcd otbr-agent ot-ctl cpc_hci_bridge cpc-hci-bridge zigbeed btattach); [ $# -gt 0 ] && ls -l "$@" 2>/dev/null | md5sum | cut -c1-32)"
	if [ -s "$f" ] && [ "$(head -n1 "$f")" = "# $key" ]; then . "$f"; return; fi
	CPCD=""; OTBR=""; BRIDGE=""; ZIGBEED=""
	case "$fw" in
	stock) CPCD=$(pick_cpcd 3); OTBR=$(pick_otbr cpc) ;;
	multipan) CPCD=$(pick_cpcd "${proto:-6}"); OTBR=$(pick_otbr cpc); ZIGBEED=$(cands zigbeed | head -n1) ;;
	rcp) OTBR=$(pick_otbr hdlc) ;;
	esac
	[ "$fw" = rcp ] || BRIDGE=$(cands cpc_hci_bridge cpc-hci-bridge | head -n1)
	OTCTL=""; [ -n "$OTBR" ] && [ -x "$(dirname "$OTBR")/ot-ctl" ] && OTCTL="$(dirname "$OTBR")/ot-ctl"
	[ -n "$OTCTL" ] || OTCTL=$(cands ot-ctl | head -n1)
	{ echo "# $key"; for v in CPCD OTBR OTCTL BRIDGE ZIGBEED; do eval "echo $v=\\\"\$$v\\\""; done; } > "$f.$$" && mv "$f.$$" "$f"
}
picks
pick1() { command -v "$1" || cands "$1" | head -n1; }
BTATTACH=$(pick1 btattach); HCICONFIG=$(pick1 hciconfig); BTMGMT=$(pick1 btmgmt)
SRC=packages; case "$CPCD$OTBR" in "$KIT"/*) SRC=kit ;; esac

otc() { [ -n "$OTCTL" ] || return 1; x timeout 10 "$OTCTL" "$@" 2>/dev/null | sed '/^Done$/d'; }
has_thread() { [ -n "$fw" ]; }
has_ble() { [ "$fw" = stock ] || [ "$fw" = multipan ]; }
has_zigbee() { [ "$fw" = multipan ]; }
# what this firmware needs and isn't there
missing() {
	case "$fw" in
	stock) [ -n "$CPCD" ] || echo "cpcd 4.2 (package cpcd or your iotkit)"
		[ -n "$OTBR" ] || echo "otbr-agent with CPC (package otbr-cpc or your iotkit)" ;;
	multipan) [ -n "$CPCD" ] || echo "cpcd 4.9 or newer (package cpcd)"
		[ -n "$OTBR" ] || echo "otbr-agent with CPC, built from Simplicity SDK 2025.6 or newer" ;;
	rcp) [ -n "$OTBR" ] || echo "otbr-agent for a UART radio (package openthread-br)" ;;
	esac
}
installed() { [ -n "$fw" ] && [ -z "$(missing)" ]; }
paired() { [ "$fw" != stock ] || [ -s "$ETC/binding.key" ] || [ -e "$ETC/noencrypt" ]; }
supported() {
	[ -e "$TTY" ] || return 1
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in askey,sbe1v1k|askey,ebe1v1k|askey,cbe1v1k) return 0 ;; esac
	return 1
}
# Thread already set up by hand in /etc/config/network (openthread-br's netifd
# protocol): two otbr-agents can't share the radio
netifd_thread() { uci -q show network | sed -n "s/^network\.\([^.]*\)\.proto='openthread'$/\1/p" | head -n1; }
lan_ip() { local a=""; . /lib/functions/network.sh 2>/dev/null && network_get_ipaddr a lan; [ -n "$a" ] || a=$(uci -q get network.lan.ipaddr | cut -d/ -f1); echo "$a"; }

gpio() {	# gpio <line> <0|1>
	local c base=""
	for c in /sys/class/gpio/gpiochip*; do
		[ "$(cat $c/label 2>/dev/null)" = "1000000.pinctrl" ] && base=$(cat $c/base)
	done
	if [ -n "$base" ] && [ -w /sys/class/gpio/export ]; then
		local n=$((base + $1))
		[ -d /sys/class/gpio/gpio$n ] || echo $n > /sys/class/gpio/export 2>/dev/null
		echo out > /sys/class/gpio/gpio$n/direction 2>/dev/null
		echo $2 > /sys/class/gpio/gpio$n/value && return 0
	fi
	command -v gpioset >/dev/null || return 1
	gpioset -t 0 -c gpiochip0 $1=$2 2>/dev/null || gpioset gpiochip0 $1=$2
}
# BLE advertising with the router's name in the advert itself (not only in
# the scan response), so routers and scanners that listen passively see it
adv_start() {
	local N hex
	N=$(uci -q get system.@system[0].hostname || echo Router); N=$(printf %s "$N" | tr -cd 'A-Za-z0-9 ._-' | cut -c1-26)
	hex=$(printf %s "$N" | hexdump -v -e '/1 "%02x"')
	for c in "power off" "le on" "bredr off" "name $N" "connectable on" "power on" "advertising off" "rm-adv 1"; do "$BTMGMT" -i hci0 $c >/dev/null 2>&1; done
	"$BTMGMT" -i hci0 add-adv -c -g -d "$(printf '%02x09' $(( ${#hex} / 2 + 1 )))$hex" 1 >/dev/null 2>&1 ||
		"$BTMGMT" -i hci0 advertising on >/dev/null 2>&1
}
adv_stop() { "$BTMGMT" -i hci0 rm-adv 1 >/dev/null 2>&1; "$BTMGMT" -i hci0 advertising off >/dev/null 2>&1; }
reset_radio() { gpio 64 1; gpio 42 0; sleep 1; gpio 42 1; sleep 2; }
stop_all() {
	/etc/init.d/home-ui-iot stop >/dev/null 2>&1
	killall cpcd otbr-agent cpc_hci_bridge cpc-hci-bridge btattach zigbeed 2>/dev/null; sleep 1
}

conf() {	# conf <encrypt 0|1> [baud] [flow] [proto]
	local p=${4:-$proto}
	{
	cat <<EOC
instance_name: cpcd_0
bus_type: UART
uart_device_file: $TTY
uart_device_baud: ${2:-${baud:-921600}}
uart_hardflow: ${3:-${flow:-true}}
bootloader_recovery_pins_enabled: false
stdout_trace: false
trace_to_file: false
enable_frame_trace: false
rlimit_nofile: 2000
disable_encryption: $([ "$1" = 1 ] && echo false || echo true)
binding_key_file: $ETC/binding.key
EOC
	# zigbeed (iid 1) and otbr-agent (iid 2) share the 15.4 endpoint
	[ "${p:-3}" -ge 4 ] && echo "multicast_endpoints: [12]"
	} > "$ETC/cpcd.conf"
}
cpcd_once() { local c="$1"; shift; x timeout "${T:-25}" "$c" -c "$ETC/cpcd.conf" "$@" > "$RUN/iot-cpcd-once.log" 2>&1; cat "$RUN/iot-cpcd-once.log"; }

firewall_zone() {
	uci -q get firewall.home_ui_thread >/dev/null && return
	uci -q batch <<-EOF
	set firewall.home_ui_thread=zone
	set firewall.home_ui_thread.name='thread'
	add_list firewall.home_ui_thread.device='wpan0'
	set firewall.home_ui_thread.input='ACCEPT'
	set firewall.home_ui_thread.output='ACCEPT'
	set firewall.home_ui_thread.forward='ACCEPT'
	set firewall.home_ui_thread_lan=forwarding
	set firewall.home_ui_thread_lan.src='lan'
	set firewall.home_ui_thread_lan.dest='thread'
	set firewall.home_ui_lan_thread=forwarding
	set firewall.home_ui_lan_thread.src='thread'
	set firewall.home_ui_lan_thread.dest='lan'
	commit firewall
	EOF
	/etc/init.d/firewall reload >/dev/null 2>&1
}
ot_wrapper() {	# ot-ctl on the command line, for your own checks
	case "$OTCTL" in "$KIT"/*) ;; *) return ;; esac
	if ! command -v ot-ctl >/dev/null || grep -qs "home-ui iot wrapper" /usr/sbin/ot-ctl; then
		printf '#!/bin/sh\n# home-ui iot wrapper\nLD_LIBRARY_PATH=%s/lib exec %s "$@"\n' "$KIT" "$OTCTL" > /usr/sbin/ot-ctl; chmod 755 /usr/sbin/ot-ctl
	fi
}
keep() { mkdir -p /lib/upgrade/keep.d; { [ -d "$KIT/bin" ] && echo "$KIT/"; echo "$ETC/"; } > /lib/upgrade/keep.d/home-ui-iot; }
job() { printf '{"state":"%s","message":"%s"}\n' "$1" "$(esc "$2")" > "$RUN/$4.$3"; }

case "$1" in
info)
	c=false; pidof cpcd >/dev/null && c=true
	o=false; pidof otbr-agent >/dev/null && o=true
	th=""; bl=""; zb=""
	# a child only talks to its parent, so its neighbour table is empty
	nb() { if [ "$st" = child ]; then otc parent | grep -q "Ext Addr" && echo 1 || echo 0; else otc neighbor list | head -n1 | wc -w; fi; }
	if [ $o = true ]; then
		st="$(otc state | head -n1)"
		th="$(printf '"state":"%s","name":"%s","channel":"%s","panid":"%s","extpanid":"%s","neighbors":%s,"address":"%s","rcp":"%s"' \
			"$(esc "$st")" "$(esc "$(otc networkname | head -n1)")" "$(otc channel | head -n1)" "$(otc panid | head -n1)" \
			"$(otc extpanid | head -n1)" "$(nb)" "$(otc ipaddr mleid | head -n1)" "$(esc "$(otc rcp version | head -n1)")")"
	fi
	if has_ble && [ -n "$HCICONFIG" ] && "$HCICONFIG" hci0 >/dev/null 2>&1; then
		h="$("$HCICONFIG" hci0)"
		up=false; echo "$h" | grep -q "UP RUNNING" && up=true
		adv=false; [ -e "$RUN/iot-adv" ] && adv=true
		bl="$(printf '"up":%s,"address":"%s","advertising":%s' "$up" "$(echo "$h" | sed -n 's/.*BD Address: \([0-9A-F:]*\).*/\1/p')" "$adv")"
	fi
	if has_zigbee; then
		zr=false; pidof zigbeed >/dev/null && zr=true
		zc=$(netstat -tn 2>/dev/null | awk -v p=":$ZPORT" '$4 ~ p"$" && $6 == "ESTABLISHED"' | wc -l)
		zb="$(printf '"running":%s,"address":"%s","port":%s,"clients":%s' "$zr" "$(lan_ip)" "$ZPORT" "$zc")"
	fi
	pk=false; [ -n "$(cands cpcd otbr-agent | grep -v "^$KIT/")" ] && pk=true
	ms="$(missing | awk 'BEGIN{ORS=""} {gsub(/"/,""); printf "%s\"%s\"", (NR>1?",":""), $0}')"
	dj=""; [ -s "$RUN/iotdetect.json" ] && dj="$(cat "$RUN/iotdetect.json")"
	printf '{"source":"%s","packages":%s,"kit":%s,"bluetooth_tools":%s,"supported":%s,"board":"%s","tty":%s,' \
		"$SRC" "$pk" "$(b [ -x "$KIT/bin/cpcd" ])" "$(b [ -n "$BRIDGE" -a -n "$BTATTACH" -a -n "$BTMGMT" ])" "$(b supported)" \
		"$(cat /tmp/sysinfo/board_name 2>/dev/null)" "$(b [ -e "$TTY" ])"
	printf '"firmware":"%s","firmware_setting":"%s","baud":"%s","features":{"thread":%s,"ble":%s,"zigbee":%s},"missing":[%s],"detect":%s,"netifd_thread":"%s",' \
		"$fw" "$(cfg firmware || echo auto)" "$baud" "$(b has_thread)" "$(b has_ble)" "$(b has_zigbee)" "$ms" "${dj:-null}" "$(netifd_thread)"
	printf '"installed":%s,"paired":%s,"enabled":%s,"ble_enabled":%s,"zigbee_enabled":%s,"zigbeed":%s,"cpcd":%s,"otbr":%s,"thread":{%s},"ble":{%s},"zigbee":{%s},"bluetooth_kmod":%s,"tun":%s}\n' \
		"$(b installed)" "$(b paired)" "$(b on enabled)" "$(b on ble)" "$(b on zigbee)" "$(b [ -n "$ZIGBEED" ])" "$c" "$o" "$th" "$bl" "$zb" \
		"$(b eval '{ modinfo hci_uart >/dev/null 2>&1 || [ -d /sys/module/hci_uart ]; }')" \
		"$(b eval '{ [ -e /dev/net/tun ] || modinfo tun >/dev/null 2>&1; }')"
	;;
detect)	# run as a job: writes $RUN/iotdetect.json
	rm -f "$RUN/iotdetect.json"
	was=$(on enabled && echo 1)
	stop_all
	found=""
	# 1. CPC firmware: any cpcd answers "Secondary CPC v..." on the right
	# speed, and tells the protocol (v3 = stock, v4+ = newer multiprotocol),
	# even when it is too old or too new to go on with it
	C=$(pick_cpcd 6); [ -n "$C" ] || C=$(pick_cpcd 3)
	if [ -n "$C" ]; then
		for s in "460800 false" "921600 true" "921600 false" "115200 false"; do
			set -- $s
			job running "Looking for CPC firmware at $1 baud…" progress iotdetect
			conf 0 "$1" "$2" 3; reset_radio
			out="$(T=12 cpcd_once "$C" -p)"
			echo "$out" | grep -q "Secondary CPC v" || continue
			p=$(echo "$out" | sed -n 's/.*Secondary Protocol v\([0-9]*\).*/\1/p' | head -n1)
			[ -n "$p" ] || p=3
			if [ "$p" -le 3 ]; then found="fw=stock baud=$1 flow=$2 proto=$p"; else found="fw=multipan baud=$1 flow=$2 proto=$p"; fi
			break
		done
	fi
	# 2. OpenThread RCP: otbr-agent for a UART radio gets an answer to
	# "rcp version"
	O=$(pick_otbr hdlc)
	if [ -z "$found" ] && [ -n "$O" ]; then
		CTL="$(dirname "$O")/ot-ctl"; [ -x "$CTL" ] || CTL=$(cands ot-ctl | head -n1)
		[ -e /dev/net/tun ] || modprobe tun 2>/dev/null
		for s in 460800 115200; do
			job running "Looking for an OpenThread radio at $s baud…" progress iotdetect
			reset_radio
			x "$O" -I wpan9 -B br-lan --auto-attach=0 -d 3 "spinel+hdlc+uart://$TTY?uart-baudrate=$s" > "$RUN/iot-detect-otbr.log" 2>&1 &
			op=$!
			v=""
			for i in $(seq 1 20); do sleep 1; kill -0 $op 2>/dev/null || break
				v="$(x timeout 3 "$CTL" -I wpan9 rcp version 2>/dev/null | head -n1)"; [ -n "$v" ] && break; done
			kill $op 2>/dev/null; sleep 1; kill -9 $op 2>/dev/null; wait $op 2>/dev/null
			[ -n "$v" ] && case "$v" in Error*) ;; *) found="fw=rcp baud=$s flow=false proto="; break ;; esac
		done
	fi
	if [ -n "$found" ]; then
		echo "$found" > "$ETC/firmware"
		uci -q set home-ui-iot.main.firmware=auto; uci -q commit home-ui-iot
		rm -f "$RUN/iot-picks"; eval "$found"
		case "$fw" in
		stock) m="Stock firmware (Thread and Bluetooth LE)" ;;
		multipan) m="Multiprotocol firmware, CPC protocol v$proto (Thread, Bluetooth LE and Zigbee)" ;;
		rcp) m="OpenThread RCP firmware (Thread only)" ;;
		esac
		job done "$m, $baud baud" json iotdetect
	else
		why="No answer from the radio."
		[ -z "$C$O" ] && why="Nothing to test with: install cpcd (for Silicon Labs firmware) or openthread-br (for an OpenThread RCP)."
		[ -n "$C" ] && [ -z "$O" ] && why="No CPC firmware answered. If the radio runs OpenThread RCP firmware, install openthread-br to detect it."
		job failed "$why" json iotdetect
	fi
	rm -f "$RUN/iotdetect.progress"
	reset_radio
	[ "$was" = 1 ] && "$0" apply >/dev/null 2>&1
	;;
install)
	f="$2"; [ -f "$f" ] || { echo '{"error":"Upload the file first"}'; exit 0; }
	tmp="$RUN/iotx"; rm -rf "$tmp"; mkdir -p "$tmp"
	tar -xzf "$f" -C "$tmp" 2>/dev/null || { echo '{"error":"Not a .tar.gz file"}'; rm -rf "$tmp" "$f"; exit 0; }
	src="$(find "$tmp" -type f -name cpcd -path '*/bin/*' | head -n1)"
	[ -n "$src" ] || { echo '{"error":"bin/cpcd is not in this file"}'; rm -rf "$tmp" "$f"; exit 0; }
	base="$(dirname "$(dirname "$src")")"
	for x in otbr-agent ot-ctl; do [ -f "$base/bin/$x" ] || { echo "{\"error\":\"bin/$x is missing\"}"; rm -rf "$tmp" "$f"; exit 0; }; done
	bad="$(find "$base" -type l | while read -r l; do case "$(readlink "$l")" in /*|*..*) echo "$l" ;; esac; done)"
	[ -z "$bad" ] || { echo '{"error":"The file contains unsafe links"}'; rm -rf "$tmp" "$f"; exit 0; }
	/etc/init.d/home-ui-iot stop >/dev/null 2>&1
	rm -rf "$KIT"; mkdir -p "$KIT"
	for d in bin lib firmware; do [ -d "$base/$d" ] && cp -a "$base/$d" "$KIT/"; done
	chmod 755 "$KIT/bin/"*
	rm -f "$RUN/iot-picks"; keep
	# the pairing key of the test kit, if there is one
	[ -s /etc/iotkit/binding.key ] && [ ! -s "$ETC/binding.key" ] && cp /etc/iotkit/binding.key "$ETC/binding.key" && chmod 600 "$ETC/binding.key"
	rm -rf "$tmp" "$f"
	logger -t home-ui "Thread/Bluetooth kit installed in $KIT"
	echo '{"ok":true}'
	;;
remove)
	/etc/init.d/home-ui-iot stop >/dev/null 2>&1
	rm -rf "$KIT"; rm -f "$RUN/iot-picks"
	grep -qs "home-ui iot wrapper" /usr/sbin/ot-ctl && rm -f /usr/sbin/ot-ctl
	keep
	"$0" apply >/dev/null 2>&1
	echo '{"ok":true}'
	;;
pair)	# run as a job: writes $RUN/iotpair.json (stock firmware only)
	[ "$fw" = stock ] || { job done "This firmware doesn't use encryption" json iotpair; exit 0; }
	installed || { job failed "Install the programs first" json iotpair; exit 0; }
	stop_all
	job running "Removing the old pairing…" progress iotpair
	conf 1; reset_radio
	u="$(cpcd_once "$CPCD" -u)"
	reset_radio
	job running "Making a new pairing key…" progress iotpair
	rm -f "$ETC/binding.key" "$ETC/noencrypt"
	cpcd_once "$CPCD" -b ecdh >/dev/null
	keep
	if [ -s "$ETC/binding.key" ]; then
		chmod 600 "$ETC/binding.key"; job done "Paired" json iotpair
	else
		conf 0; reset_radio
		if cpcd_once "$CPCD" -p | grep -q "Secondary CPC v"; then touch "$ETC/noencrypt"; job done "Connected without encryption" json iotpair
		elif echo "$u" | grep -qi "refused\|not.*implemented"; then job failed "The radio refused to unpair. See $RUN/iot-cpcd-once.log" json iotpair
		else job failed "Pairing failed. See $RUN/iot-cpcd-once.log" json iotpair; fi
	fi
	rm -f "$RUN/iotpair.progress"
	on enabled && /etc/init.d/home-ui-iot start >/dev/null 2>&1
	;;
services)	# for the init script: one name per line
	on enabled && installed && paired || exit 0
	[ -n "$(netifd_thread)" ] && exit 0
	[ "$fw" = rcp ] || echo cpcd
	echo otbr
	has_ble && on ble && [ -n "$BRIDGE" ] && [ -n "$BTATTACH" ] && echo ble
	has_zigbee && on zigbee && [ -n "$ZIGBEED" ] && echo zigbee
	;;
apply)
	if on enabled && installed && paired && [ -z "$(netifd_thread)" ]; then
		firewall_zone; ot_wrapper; keep
		/etc/init.d/home-ui-iot enable; /etc/init.d/home-ui-iot restart
	else
		/etc/init.d/home-ui-iot stop; /etc/init.d/home-ui-iot disable
	fi >/dev/null 2>&1
	echo '{"ok":true}'
	;;
takeover)	# Thread set up in /etc/config/network: run it from here instead
	i="$(netifd_thread)"; [ -n "$i" ] || { echo '{"ok":true}'; exit 0; }
	ds="$(uci -q get network."$i".dataset)"
	ifdown "$i" 2>/dev/null; sleep 2; killall otbr-agent 2>/dev/null
	uci -q delete network."$i"; uci -q commit network; /etc/init.d/network reload >/dev/null 2>&1
	uci -q set home-ui-iot.main.enabled=1; uci -q commit home-ui-iot
	"$0" apply >/dev/null
	if [ -n "$ds" ]; then
		for i in $(seq 1 40); do sleep 1; [ -n "$(otc state | head -n1)" ] && break; done
		r="$("$0" thread-join "$ds")"
		case "$r" in *error*) echo "$r"; exit 0 ;; esac
	fi
	echo '{"ok":true}'
	;;
run-cpcd)
	# another cpcd (for example the test kit's) already owns the radio:
	# don't reset the radio under it, just wait and try again later
	if pidof cpcd >/dev/null; then
		logger -t home-ui-iot "another cpcd is running (test kit?); run 'iot stop' in the kit folder"
		sleep 60; exit 1
	fi
	[ -n "$CPCD" ] || { logger -t home-ui-iot "no cpcd for this firmware"; sleep 3600; exit 1; }
	if [ "$fw" = stock ] && [ ! -e "$ETC/noencrypt" ]; then conf 1; else conf 0; fi
	reset_radio
	xexec "$CPCD" -c "$ETC/cpcd.conf"
	;;
run-otbr)
	# keep the Thread network (otbr stores it in /var/lib/thread) across restarts
	mkdir -p "$ETC/thread" /var/lib
	[ -L /var/lib/thread ] || { rm -rf /var/lib/thread; ln -s "$ETC/thread" /var/lib/thread; }
	[ -e /dev/net/tun ] || modprobe tun 2>/dev/null
	case "$fw" in
	rcp)
		reset_radio
		xexec "$OTBR" -I wpan0 -B br-lan -d 3 "spinel+hdlc+uart://$TTY?uart-baudrate=${baud:-460800}" "trel://br-lan" ;;
	*)
		# wait for cpcd: it resets the radio (and on the stock firmware does
		# the encrypted handshake) before Thread can open its channel
		for i in $(seq 1 60); do pidof cpcd >/dev/null && [ -S /dev/shm/cpcd/cpcd_0/ctrl.cpcd.sock ] && break; sleep 1; done
		sleep 6
		if [ "$fw" = multipan ]; then u='spinel+cpc://cpcd_0?iid=2&iid-list=0'; else u='spinel+cpc://cpcd_0?iid=2'; fi
		xexec "$OTBR" -I wpan0 -B br-lan -d 3 "$u" ;;
	esac
	;;
run-ble)
	modprobe bluetooth 2>/dev/null; modprobe hci_uart 2>/dev/null
	[ -d /sys/module/hci_uart ] || { logger -t home-ui-iot "Bluetooth: kmod-hci-uart missing"; sleep 3600; exit 1; }
	sleep 6
	# BlueZ scans at 100 % duty, which starves 802.15.4 on a shared radio;
	# a bridge with the scan duty patch caps it (others ignore this)
	[ "$fw" = multipan ] && export CPC_HCI_BRIDGE_MAX_SCAN_DUTY=50
	cd "$RUN" && rm -f pts_hci
	x "$BRIDGE" > "$RUN/iot-ble-bridge.log" 2>&1 &
	bp=$!
	for i in 1 2 3 4 5; do sleep 1; [ -e "$RUN/pts_hci" ] && break; done
	P=$(readlink -f "$RUN/pts_hci" 2>/dev/null)
	[ -n "$P" ] || P=$(sed -n "s/.*opened at '\(.*\)'.*/\1/p" "$RUN/iot-ble-bridge.log" | head -n1)
	[ -n "$P" ] || { kill $bp; exit 1; }
	trap 'kill $bp 2>/dev/null' EXIT INT TERM
	( sleep 4; "$HCICONFIG" hci0 up; "$BTMGMT" -i hci0 power on; "$BTMGMT" -i hci0 le on ) >/dev/null 2>&1 &
	"$BTATTACH" -B "$P" -P h4
	;;
run-zigbee)
	# zigbeed is the Zigbee stack (EmberZNet); it serves EZSP on the LAN for
	# Zigbee2MQTT ("ember" adapter) or Home Assistant ZHA ("socket://…")
	for i in $(seq 1 60); do pidof cpcd >/dev/null && [ -S /dev/shm/cpcd/cpcd_0/ctrl.cpcd.sock ] && break; sleep 1; done
	sleep 4
	A="$(lan_ip)"; [ -n "$A" ] || { logger -t home-ui-iot "Zigbee: br-lan has no IPv4 address"; sleep 30; exit 1; }
	mkdir -p "$ETC/zigbeed"; cd "$ETC/zigbeed" || exit 1
	xexec "$ZIGBEED" --radio-url 'spinel+cpc://cpcd_0?iid=1&iid-list=0' --ezsp-listen "$A" --ezsp-listen-port "$ZPORT"
	;;
thread-form)
	n="${2:-RouterHome}"; case "$n" in *[!A-Za-z0-9_-]*|'') echo '{"error":"Use letters, numbers, - and _"}'; exit 0 ;; esac
	old="$(otc networkkey | head -n1)"
	# Forget the old network completely first: the stored network key
	# (a key reference on these builds) is otherwise kept and reused.
	otc factoryreset >/dev/null
	for i in $(seq 1 30); do sleep 1; s="$(otc state | head -n1)"; [ -n "$s" ] && break; done
	[ -n "$s" ] || { echo '{"error":"otbr-agent did not come back after the reset"}'; exit 0; }
	r="$(otc thread stop; otc ifconfig down; otc dataset clear; otc dataset init new; otc dataset networkname "$n"; otc dataset commit active; otc ifconfig up; otc thread start)"
	err="$(echo "$r" | grep -m1 '^Error')"
	[ -n "$err" ] && { printf '{"error":"Thread refused: %s"}\n' "$(esc "$err")"; exit 0; }
	new="$(otc networkkey | head -n1)"
	[ -n "$old" ] && [ "$old" = "$new" ] && { echo '{"error":"The network key did not change. Try again, or restart the radio."}'; exit 0; }
	echo '{"ok":true}'
	;;
thread-join)
	d="$2"; case "$d" in ''|*[!0-9a-fA-F]*) echo '{"error":"The dataset is a long hexadecimal text"}'; exit 0 ;; esac
	otc factoryreset >/dev/null
	for i in $(seq 1 30); do sleep 1; [ -n "$(otc state | head -n1)" ] && break; done
	otc thread stop >/dev/null; otc ifconfig down >/dev/null
	otc dataset set active "$d" >/dev/null && otc ifconfig up >/dev/null && otc thread start >/dev/null || { echo '{"error":"Dataset refused"}'; exit 0; }
	echo '{"ok":true}'
	;;
thread-leave) otc thread stop >/dev/null; otc ifconfig down >/dev/null; otc factoryreset >/dev/null; echo '{"ok":true}' ;;
thread-dataset) printf '{"dataset":"%s"}\n' "$(otc dataset active -x | head -n1)" ;;
thread-scan)
	otc ifconfig up >/dev/null
	printf '{"networks":['
	otc scan | awk -F'|' 'NF>6 {for(i=2;i<=NF;i++) gsub(/^ +| +$/,"",$i)} NF>6 && $2 ~ /^[0-9]+$/ {printf "%s{\"name\":\"%s\",\"extpanid\":\"%s\",\"panid\":\"%s\",\"channel\":\"%s\",\"rssi\":\"%s\"}", (c++?",":""), $3, $4, $5, $7, $8}'
	printf ']}\n'
	;;
ble-scan)
	"$HCICONFIG" hci0 >/dev/null 2>&1 || { echo '{"error":"Bluetooth is off"}'; exit 0; }
	# pause our own advertising while scanning: the radio then scans
	# actively and gets the scan responses that carry most device names
	[ -e "$RUN/iot-adv" ] && adv_stop
	printf '{"devices":['
	# let btmgmt end the discovery itself (about 10.3 s): killed before that,
	# it loses its output, which is buffered when it writes to a pipe
	timeout 20 "$BTMGMT" -i hci0 find -l 2>/dev/null | awk '
		# a device is often reported several times (advert, then scan
		# response with its name): keep the strongest signal and any name
		/dev_found:/ {
			a=$3; for (i=4;i<NF;i++) if ($i=="rssi") { r=$(i+1)+0; if (!(a in rs) || r>rs[a]) rs[a]=r }
			if (!(a in rs)) rs[a]=0
			if (!(a in seen)) { seen[a]=1; ord[++k]=a }
			next
		}
		/^[ \t]*name / && a!="" { x=$0; sub(/^[ \t]*name /,"",x); gsub(/["\\]/,"",x); if (x!="") nm[a]=x }
		END { for (j=1;j<=k;j++) { a=ord[j]; printf "%s{\"address\":\"%s\",\"rssi\":%d,\"name\":\"%s\"}", (j>1?",":""), a, rs[a], nm[a] } }'
	printf ']}\n'
	[ -e "$RUN/iot-adv" ] && adv_start
	;;
ble-adv)
	"$HCICONFIG" hci0 >/dev/null 2>&1 || { echo '{"error":"Bluetooth is off"}'; exit 0; }
	if [ "$2" = on ]; then
		adv_start; touch "$RUN/iot-adv"
	else
		adv_stop; rm -f "$RUN/iot-adv"
	fi
	echo '{"ok":true}'
	;;
*) sed -n '2,29p' "$0"; exit 1 ;;
esac
