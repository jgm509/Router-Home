#!/bin/sh
# Router Home: is a newer release on GitHub?
#
#   update-check [force]   JSON: current, latest, newer, notes, url, enabled
#                          (asks GitHub at most once a day unless "force")
#   update-check install   download the latest release, check it and install it
#
# A downloaded release must match the sha256 GitHub lists for it and, once
# /usr/share/home-ui/release.pub exists, carry a home-ui.tar.gz.sig made with
# that key (usign). The key comes from the installed Router Home, never from the
# download, so a release can only replace Router Home if it was signed by the
# same person who signed the installed one.
#
# The repository is home-ui.main.update_repo (default jgm509/router-home);
# home-ui.main.update_check=0 turns the check off.
. /usr/share/libubox/jshn.sh

RUN=/tmp/home-ui
CACHE=$RUN/update-check.json
MAXAGE=86400
KEY=/usr/share/home-ui/release.pub
DL=/tmp/home-ui-update.tar.gz
KEYED=0; [ -s "$KEY" ] && KEYED=1
CUR=$(cat /usr/share/home-ui/version 2>/dev/null)
REPO=$(uci -q get home-ui.main.update_repo); REPO=${REPO:-jgm509/router-home}
ENABLED=$(uci -q get home-ui.main.update_check); [ "$ENABLED" = 0 ] || ENABLED=1
mkdir -p "$RUN"

# 1 when version $1 is newer than $2 (numbers compared part by part, a leading v ignored)
newer() {
	echo "${1#v} ${2#v}" | awk '{
		n = split($1, a, "."); m = split($2, b, "."); k = n > m ? n : m
		for (i = 1; i <= k; i++) { x = a[i] + 0; y = b[i] + 0; if (x > y) { print 1; exit } if (x < y) { print 0; exit } }
		print 0 }'
}
# Downloads go through GitHub's API (api.github.com), never the github.com web
# pages: since November 2026 github.com sends a header line longer than 4 KB,
# and OpenWrt's wget (uclient-fetch) stalls on any header line longer than its
# 4 KB read buffer. The API answers a file request with a redirect to the file
# itself, all with short headers. curl copes with either, so it is used when
# installed.
#   fetch <url> <file> [binary]   binary: ask the API for the file, not its JSON
fetch() {
	local acc="application/vnd.github+json"
	[ "$3" = binary ] && acc="application/octet-stream"
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL -m 120 -A "RouterHome/$CUR" -H "Accept: $acc" -o "$2" "$1" 2>/dev/null
	else
		wget -q -T 30 -U "RouterHome/$CUR" --header "Accept: $acc" -O "$2" "$1" 2>/dev/null
	fi
}
fail() { json_init; json_add_string current "$CUR"; json_add_boolean enabled "$ENABLED"; json_add_string error "$1"; json_dump; exit 0; }

case "$1" in
install)
	"$0" force >/dev/null	# fresh links: the cached ones may be a day old
	URL=$(jsonfilter -i "$CACHE" -e '@.asset' 2>/dev/null)
	[ -n "$URL" ] || fail "The release has no home-ui.tar.gz to download"
	SIG=$(jsonfilter -i "$CACHE" -e '@.sig' 2>/dev/null)
	SUM=$(jsonfilter -i "$CACHE" -e '@.digest' 2>/dev/null); SUM=${SUM#sha256:}
	if [ -s "$KEY" ]; then
		command -v usign >/dev/null || fail "usign is missing, so the update can't be checked. Install it (apk add usign, or opkg install usign) and try again"
		[ -n "$SIG" ] || fail "This release isn't signed, so Router Home won't install it. Download home-ui.tar.gz yourself and use Install from a file if you trust it"
	fi
	bad() { rm -f "$DL" "$DL.sig"; fail "$1"; }
	rm -f "$DL" "$DL.sig"
	fetch "$URL" "$DL" binary || bad "The download failed. Is the router online?"
	[ "$(wc -c < "$DL")" -le $((8 * 1024 * 1024)) ] || bad "The download is too big for a Router Home update"
	[ -z "$SUM" ] || [ "$(sha256sum "$DL" | cut -d' ' -f1)" = "$SUM" ] || bad "The download is damaged (its checksum doesn't match). Try again"
	if [ -s "$KEY" ]; then
		fetch "$SIG" "$DL.sig" binary || bad "The signature could not be downloaded. Try again"
		usign -V -q -m "$DL" -p "$KEY" -x "$DL.sig" 2>/dev/null ||
			bad "This release is not signed with the Router Home release key, so it was not installed"
	fi
	rm -f "$CACHE" "$DL.sig"
	exec /usr/libexec/home-ui/self-update "$DL"
	;;
esac

if [ "$ENABLED" = 0 ] && [ "$1" != force ]; then
	json_init; json_add_string current "$CUR"; json_add_boolean enabled 0; json_dump; exit 0
fi

# a cached answer from today, unless asked to check now
if [ "$1" != force ] && [ -s "$CACHE" ] && [ -n "$(find "$CACHE" -mmin -$((MAXAGE / 60)) 2>/dev/null)" ]; then
	L=$(jsonfilter -i "$CACHE" -e '@.latest' 2>/dev/null)
	# the installed version may have changed since: work "newer" out again
	json_load "$(cat "$CACHE")"; json_add_string current "$CUR"; json_add_boolean newer "$(newer "$L" "$CUR")"
	json_add_boolean enabled "$ENABLED"; json_add_boolean verify "$KEYED"; json_dump; exit 0
fi

T=$RUN/update-release.json
fetch "https://api.github.com/repos/$REPO/releases/latest" "$T" || { rm -f "$T"; fail "Could not reach GitHub. Is the router online?"; }
TAG=$(jsonfilter -i "$T" -e '@.tag_name' 2>/dev/null)
[ -n "$TAG" ] || { rm -f "$T"; fail "GitHub didn't answer with a release"; }
json_init
json_add_string latest "${TAG#v}"
json_add_string name "$(jsonfilter -i "$T" -e '@.name' 2>/dev/null)"
json_add_string notes "$(jsonfilter -i "$T" -e '@.body' 2>/dev/null | head -c 4000)"
json_add_string published "$(jsonfilter -i "$T" -e '@.published_at' 2>/dev/null | cut -c1-10)"
json_add_string url "$(jsonfilter -i "$T" -e '@.html_url' 2>/dev/null)"
# the files' API addresses ("url"), not their github.com links: see fetch()
json_add_string asset "$(jsonfilter -i "$T" -e '@.assets[@.name="home-ui.tar.gz"].url' 2>/dev/null)"
json_add_string digest "$(jsonfilter -i "$T" -e '@.assets[@.name="home-ui.tar.gz"].digest' 2>/dev/null)"
SIGURL=$(jsonfilter -i "$T" -e '@.assets[@.name="home-ui.tar.gz.sig"].url' 2>/dev/null)
json_add_string sig "$SIGURL"
json_add_boolean signed "$([ -n "$SIGURL" ] && echo 1 || echo 0)"
json_dump > "$CACHE.$$" && mv "$CACHE.$$" "$CACHE"
rm -f "$T"
json_add_string current "$CUR"
json_add_boolean newer "$(newer "$TAG" "$CUR")"
json_add_boolean enabled "$ENABLED"
json_add_boolean verify "$KEYED"
json_dump
