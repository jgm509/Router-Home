#!/bin/sh
# Router Home: system pages (monitoring, storage, tools, services, cron,
# packages, lights). Every command prints JSON.
#   sysx stat                       cpu jiffies, memory, load, temperatures
#   sysx storage                    mounted file systems
#   sysx tool <ping|trace|lookup> <target> [count] [6]   (run as a job)
#   sysx tool-status
#   sysx tables                     ARP/neighbour table and routes
#   sysx services                   /etc/init.d scripts, enabled and running
#   sysx service <name> <start|stop|restart|enable|disable>
#   sysx cron-get | cron-set <file>
#   sysx pkg-list | pkg-search <text> | pkg-upgradable
#   sysx pkg <install|remove|update|upgrade> [names]     (run as a job)
#   sysx leds | led-set <name> <trigger> [brightness] [persist 0|1]
#   sysx night <off|on> | night-get | night-set <on 0|1> <off HH:MM> <on HH:MM>
RUN=/tmp/home-ui
mkdir -p "$RUN"
have() { command -v "$1" >/dev/null 2>&1; }
esc() { printf '%s' "$1" | awk 'BEGIN{ORS=""} {gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/,"\\t"); gsub(/\r/,""); gsub(/[\001-\037]/,""); if (NR>1) printf "\\n"; print}'; }
CRON=${CRON:-/etc/crontabs/root}
LEDS=${LEDS:-/sys/class/leds}

temps() {
	local first=1 z t n p
	for z in /sys/class/thermal/thermal_zone*; do
		[ -r "$z/temp" ] || continue
		t="$(cat "$z/temp" 2>/dev/null)"; case "$t" in ''|*[!0-9-]*) continue ;; esac
		n="$(cat "$z/type" 2>/dev/null)"
		[ $first = 1 ] || printf ','; first=0
		printf '{"name":"%s","path":"%s","temp":%s}' "$(esc "$n")" "${z##*/}" "$t"
	done
	for p in /sys/class/hwmon/hwmon*/temp*_input; do
		[ -r "$p" ] || continue
		t="$(cat "$p" 2>/dev/null)"; case "$t" in ''|*[!0-9-]*) continue ;; esac
		n="$(cat "${p%/*}/name" 2>/dev/null)"
		l="$(cat "${p%_input}_label" 2>/dev/null)"
		[ $first = 1 ] || printf ','; first=0
		h="${p%/*}"; printf '{"name":"%s","path":"%s","temp":%s}' "$(esc "$n${l:+ $l}")" "${h##*/}/${p##*/}" "$t"
	done
}

case "$1" in
stat)
	cpu="$(awk '/^cpu /{t=0; for(i=2;i<=NF;i++) t+=$i; print t "," $5+$6; exit}' /proc/stat)"
	n="$(grep -c '^processor' /proc/cpuinfo)"
	mem="$(awk '/^(MemTotal|MemFree|MemAvailable|Buffers|Cached|SwapTotal|SwapFree):/{gsub(":","",$1); printf "%s\"%s\":%s", (c++?",":""), $1, $2*1024}' /proc/meminfo)"
	set -- $(cat /proc/loadavg)
	up="$(cut -d. -f1 /proc/uptime)"
	procs="$(ls -d /proc/[0-9]* 2>/dev/null | wc -l)"
	printf '{"cpu":[%s],"cpus":%s,"mem":{%s},"load":[%s,%s,%s],"uptime":%s,"procs":%s,"temps":[%s]}\n' \
		"$cpu" "${n:-1}" "$mem" "$1" "$2" "$3" "$up" "$procs" "$(temps)"
	;;

storage)
	printf '{"mounts":['
	df -kP 2>/dev/null | awk 'NR>1 && $2>0' | while read -r dev size used avail pct mnt; do
		type="$(awk -v m="$mnt" '$2==m{t=$3} END{print t}' /proc/mounts)"
		printf '%s{"device":"%s","mount":"%s","type":"%s","size":%s,"used":%s,"avail":%s}' "${c:+,}" "$(esc "$dev")" "$(esc "$mnt")" "$type" $((size*1024)) $((used*1024)) $((avail*1024))
		c=1
	done
	ov="$(awk '$2=="/overlay"{print $1 " " $3; exit}' /proc/mounts)"
	printf '],"overlay":"%s"}\n' "$(esc "$ov")"
	;;

tool)
	t="$2"; host="$3"; cnt="${4:-4}"
	case "$host" in ''|-*|*[!A-Za-z0-9.:_-]*) echo '{"state":"failed","output":"Use a name or address"}' > "$RUN/tool.json"; exit 0 ;; esac
	case "$cnt" in *[!0-9]*|'') cnt=4 ;; esac; [ "$cnt" -gt 20 ] && cnt=20
	six=""; [ "$5" = 6 ] && six=6
	o="$RUN/tool.out"; : > "$o"
	printf '{"state":"running","tool":"%s","target":"%s"}\n' "$t" "$host" > "$RUN/tool.progress"
	case "$t" in
	ping) if [ -n "$six" ] && have ping6; then ping6 -c "$cnt" -W 3 "$host" > "$o" 2>&1; else ping ${six:+-6} -c "$cnt" -W 3 "$host" > "$o" 2>&1; fi ;;
	trace) if [ -n "$six" ] && have traceroute6; then traceroute6 -w 2 -q 1 -m 20 "$host" > "$o" 2>&1; else traceroute ${six:+-6} -w 2 -q 1 -m 20 "$host" > "$o" 2>&1; fi ;;
	lookup) nslookup "$host" > "$o" 2>&1 ;;
	*) echo "unknown tool" > "$o" ;;
	esac
	rc=$?
	printf '{"state":"done","tool":"%s","target":"%s","rc":%s,"output":"%s"}\n' "$t" "$host" "$rc" "$(esc "$(head -c 20000 "$o")")" > "$RUN/tool.json"
	rm -f "$RUN/tool.progress"
	;;
tool-status)
	if [ -f "$RUN/tool.progress" ]; then
		p="$(cat "$RUN/tool.progress")"
		printf '%s,"output":"%s"}\n' "${p%\}}" "$(esc "$(head -c 20000 "$RUN/tool.out" 2>/dev/null)")"
	else cat "$RUN/tool.json" 2>/dev/null || echo '{"state":"idle"}'; fi
	;;

tables)
	printf '{"neigh":"%s","route":"%s","route6":"%s"}\n' "$(esc "$(ip neigh show 2>/dev/null)")" "$(esc "$(ip route show 2>/dev/null)")" "$(esc "$(ip -6 route show 2>/dev/null)")"
	;;

services)
	run="$(ubus call service list 2>/dev/null)"
	printf '{"services":['
	c=""
	for f in /etc/init.d/*; do
		[ -x "$f" ] || continue
		n="${f##*/}"
		case "$n" in *.*|rcS|rc.*) continue ;; esac
		en=false; ls /etc/rc.d/S??"$n" >/dev/null 2>&1 && en=true
		ru=false
		if echo "$run" | grep -q "\"$n\": {"; then
			echo "$run" | jsonfilter -e "@['$n'].instances[*].running" 2>/dev/null | grep -q true && ru=true
		fi
		sp=""; grep -q 'USE_PROCD=1' "$f" 2>/dev/null && sp=procd
		printf '%s{"name":"%s","enabled":%s,"running":%s,"kind":"%s"}' "$c" "$n" "$en" "$ru" "$sp"
		c=,
	done
	printf ']}\n'
	;;
service)
	n="$2"; a="$3"
	case "$n" in ''|*[!A-Za-z0-9_.-]*) echo '{"error":"bad name"}'; exit 0 ;; esac
	[ -x "/etc/init.d/$n" ] || { echo '{"error":"not installed"}'; exit 0; }
	case "$a" in start|restart|enable) ;;
	stop|disable)
		case "$n" in rpcd|uhttpd|network|ubus|boot|done|umount|log|sysntpd_never) echo '{"error":"Router Home needs this one. Use the advanced settings if you really want to stop it."}'; exit 0 ;; esac ;;
	*) echo '{"error":"bad action"}'; exit 0 ;;
	esac
	if [ "$a" = restart ] || [ "$a" = start ] || [ "$a" = stop ]; then
		( "/etc/init.d/$n" "$a" >/dev/null 2>&1 & ) </dev/null
	else
		"/etc/init.d/$n" "$a" >/dev/null 2>&1
	fi
	echo '{"ok":true}'
	;;

cron-get)
	en=false; ls /etc/rc.d/S??cron >/dev/null 2>&1 && en=true
	printf '{"text":"%s","enabled":%s}\n' "$(esc "$(cat "$CRON" 2>/dev/null)")" "$en"
	;;
cron-set)
	[ -f "$2" ] || { echo '{"error":"no file"}'; exit 0; }
	bad="$(grep -v '^[[:space:]]*#' "$2" | grep -v '^[[:space:]]*$' | awk '$1 !~ /^@/ && NF<6' | head -n1)"
	[ -n "$bad" ] && { printf '{"error":"This line is not a valid schedule: %s"}\n' "$(esc "$bad")"; exit 0; }
	mkdir -p "${CRON%/*}"
	cp "$2" "$CRON"; chmod 600 "$CRON"
	/etc/init.d/cron enable >/dev/null 2>&1
	/etc/init.d/cron restart >/dev/null 2>&1
	echo '{"ok":true}'
	;;

pkg-list)
	if have apk; then
		apk info -v 2>/dev/null | sed 's/-\([0-9][^-]*-r[0-9]*\)$/ \1/' | sort
	else
		opkg list-installed 2>/dev/null | sed 's/ - / /'
	fi > "$RUN/pkgs.txt"
	user=""
	if have apk; then user="$(cat /etc/apk/world 2>/dev/null)"; else user="$(opkg list-installed 2>/dev/null | cut -d' ' -f1 | while read -r p; do opkg status "$p" 2>/dev/null | grep -q 'user installed' && echo "$p"; done)"; fi
	printf '{"manager":"%s","packages":[' "$(have apk && echo apk || echo opkg)"
	echo "$user" > "$RUN/pkgs.world"
	awk 'NR==FNR{w[$1]=1; next} {printf "%s{\"name\":\"%s\",\"version\":\"%s\",\"user\":%s}", (c++?",":""), $1, $2, ($1 in w)?"true":"false"}' "$RUN/pkgs.world" "$RUN/pkgs.txt"
	printf ']}\n'
	;;
pkg-search)
	q="$2"; case "$q" in ''|*[!A-Za-z0-9._+-]*) echo '{"error":"Use letters, numbers, dots and dashes"}'; exit 0 ;; esac
	printf '{"packages":['
	if have apk; then
		apk search -v "$q" 2>/dev/null | head -n 80 | awk '{n=$1; sub(/-[0-9][^-]*-r[0-9]*$/,"",n); v=substr($1,length(n)+2); $1=""; d=$0; sub(/^ +/,"",d); sub(/^- */,"",d); gsub(/\\/,"",d); gsub(/"/,"\x27",d); printf "%s{\"name\":\"%s\",\"version\":\"%s\",\"description\":\"%s\"}", (c++?",":""), n, v, d}'
	else
		opkg find "*$q*" 2>/dev/null | head -n 80 | awk -F' - ' '{d=$3; gsub(/\\/,"",d); gsub(/"/,"\x27",d); printf "%s{\"name\":\"%s\",\"version\":\"%s\",\"description\":\"%s\"}", (c++?",":""), $1, $2, d}'
	fi
	printf ']}\n'
	;;
pkg-upgradable)
	printf '{"packages":['
	if have apk; then
		apk list --upgradable 2>/dev/null | head -n 200 | awk '{n=$1; sub(/-[0-9][^-]*-r[0-9]*$/,"",n); v=substr($1,length(n)+2); o=$NF; gsub(/[\]\[]/,"",o); sub(/.*: */,"",o); printf "%s{\"name\":\"%s\",\"version\":\"%s\"}", (c++?",":""), n, v}'
	else
		opkg list-upgradable 2>/dev/null | awk -F' - ' '{printf "%s{\"name\":\"%s\",\"from\":\"%s\",\"version\":\"%s\"}", (c++?",":""), $1, $2, $3}'
	fi
	printf ']}\n'
	;;
pkg)
	a="$2"; shift 2
	for p in "$@"; do case "$p" in ''|-*|*[!A-Za-z0-9._+-]*) echo '{"state":"failed","message":"bad package name"}' > "$RUN/pkgx.json"; exit 0 ;; esac; done
	log=/tmp/home-ui-pkgx.log; : > "$log"
	say() { printf '{"state":"%s","action":"%s","message":"%s","log":"%s"}\n' "$1" "$a" "$(esc "$2")" "$(esc "$(tail -n 12 "$log")")" > "$RUN/pkgx.$3"; }
	say running "Working…" progress
	if have apk; then
		case "$a" in
		update) apk update >>"$log" 2>&1 ;;
		install) apk update >>"$log" 2>&1; say running "Installing $*…" progress; apk add "$@" >>"$log" 2>&1 ;;
		remove) apk del "$@" >>"$log" 2>&1 ;;
		upgrade) apk update >>"$log" 2>&1; say running "Updating $*…" progress; apk add -u "$@" >>"$log" 2>&1 ;;
		esac
	else
		case "$a" in
		update) opkg update >>"$log" 2>&1 ;;
		install) opkg update >>"$log" 2>&1; say running "Installing $*…" progress; opkg install "$@" >>"$log" 2>&1 ;;
		remove) opkg remove "$@" >>"$log" 2>&1 ;;
		upgrade) opkg update >>"$log" 2>&1; say running "Updating $*…" progress; opkg upgrade "$@" >>"$log" 2>&1 ;;
		esac
	fi
	rc=$?
	rm -f /tmp/luci-indexcache* /tmp/luci-modulecache 2>/dev/null
	[ $rc = 0 ] && say done "Done" json || say failed "It didn't work. Is the router online?" json
	rm -f "$RUN/pkgx.progress"
	logger -t home-ui "packages: $a $* (rc $rc)"
	;;

leds)
	printf '{"leds":['
	c=""
	for d in "$LEDS"/*; do
		[ -d "$d" ] || continue
		n="${d##*/}"
		tr="$(cat "$d/trigger" 2>/dev/null)"
		cur="$(echo "$tr" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')"
		all="$(echo "$tr" | tr -d '[]' | tr ' ' '\n' | grep -v '^$' | grep -v '^phy[0-9]' | awk '{printf "%s\"%s\"", (c++?",":""), $1}')"
		sec="$(uci -q show system 2>/dev/null | sed -n "s/^system\.\([^.]*\)\.sysfs='$n'$/\1/p" | head -n1)"
		printf '%s{"name":"%s","brightness":%s,"max":%s,"trigger":"%s","triggers":[%s],"section":"%s"}' "$c" "$n" \
			"$(cat "$d/brightness" 2>/dev/null || echo 0)" "$(cat "$d/max_brightness" 2>/dev/null || echo 1)" "${cur:-none}" "$all" "$sec"
		c=,
	done
	printf '],"night":%s}\n' "$([ -f "$RUN/night" ] && echo true || echo false)"
	;;
led-set)
	n="$2"; t="$3"; b="$4"; keep="$5"
	case "$n" in ''|*/*|.*) echo '{"error":"bad name"}'; exit 0 ;; esac
	d="$LEDS/$n"; [ -d "$d" ] || { echo '{"error":"no such light"}'; exit 0; }
	case "$t" in ''|*[!A-Za-z0-9_:-]*) echo '{"error":"bad trigger"}'; exit 0 ;; esac
	max="$(cat "$d/max_brightness" 2>/dev/null || echo 1)"
	case "$b" in ''|*[!0-9]*) b="$max" ;; esac; [ "$b" -gt "$max" ] && b="$max"
	echo "$t" > "$d/trigger" 2>/dev/null
	[ "$t" = none ] && echo "$b" > "$d/brightness" 2>/dev/null
	[ "$t" = default-on ] && echo "$b" > "$d/brightness" 2>/dev/null
	if [ "$keep" = 1 ]; then
		sec="$(uci -q show system | sed -n "s/^system\.\([^.]*\)\.sysfs='$n'$/\1/p" | head -n1)"
		if [ -z "$sec" ]; then
			sec="home_ui_$(echo "$n" | tr -c 'A-Za-z0-9\n' '_')"
			uci -q set system."$sec"=led
			uci -q set system."$sec".name="$n"
			uci -q set system."$sec".sysfs="$n"
		fi
		case "$t" in
		none) uci -q set system."$sec".trigger=none; uci -q set system."$sec".default="$([ "$b" -gt 0 ] && echo 1 || echo 0)" ;;
		default-on) uci -q set system."$sec".trigger=default-on; uci -q set system."$sec".default=1 ;;
		*) uci -q set system."$sec".trigger="$t" ;;
		esac
		uci -q delete system."$sec".brightness
		[ "$b" != "$max" ] && [ "$b" -gt 0 ] && uci -q set system."$sec".brightness="$b"
		uci -q commit system
	fi
	echo '{"ok":true}'
	;;
night)
	case "$2" in
	off)
		[ -f "$RUN/night" ] && { echo '{"ok":true}'; exit 0; }
		: > "$RUN/night"
		for s in home-ui-light cbe-led sbe-led status-led; do
			[ -x /etc/init.d/$s ] || continue
			/etc/init.d/$s running >/dev/null 2>&1 || pgrep -f "$s" >/dev/null 2>&1 || continue
			echo "$s" >> "$RUN/night.services"
			/etc/init.d/$s stop >/dev/null 2>&1
		done
		for d in "$LEDS"/*; do
			[ -d "$d" ] || continue
			echo "${d##*/} $(sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$d/trigger") $(cat "$d/brightness")" >> "$RUN/night"
			echo none > "$d/trigger" 2>/dev/null; echo 0 > "$d/brightness" 2>/dev/null
		done
		;;
	on)
		[ -f "$RUN/night" ] || { echo '{"ok":true}'; exit 0; }
		while read -r n t b; do
			[ -d "$LEDS/$n" ] && [ -n "$t" ] || continue
			echo "$t" > "$LEDS/$n/trigger" 2>/dev/null
			[ "$t" = none ] && echo "$b" > "$LEDS/$n/brightness" 2>/dev/null
		done < "$RUN/night"
		rm -f "$RUN/night"
		[ -f "$RUN/night.services" ] && while read -r s; do /etc/init.d/$s start >/dev/null 2>&1; done < "$RUN/night.services"
		rm -f "$RUN/night.services"
		;;
	esac
	echo '{"ok":true}'
	;;
night-get)
	l="$(grep 'sysx night off' "$CRON" 2>/dev/null | head -n1)"; m="$(grep 'sysx night on' "$CRON" 2>/dev/null | head -n1)"
	if [ -n "$l" ]; then
		set -- $l; off="$(printf '%02d:%02d' "$2" "$1")"
		set -- $m; on="$(printf '%02d:%02d' "${2:-7}" "${1:-0}")"
		printf '{"enabled":true,"off":"%s","on":"%s","now":%s}\n' "$off" "$on" "$([ -f "$RUN/night" ] && echo true || echo false)"
	else
		printf '{"enabled":false,"off":"23:00","on":"07:00","now":%s}\n' "$([ -f "$RUN/night" ] && echo true || echo false)"
	fi
	;;
night-set)
	en="$2"; off="$3"; on="$4"
	for x in "$off" "$on"; do echo "$x" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$' || { echo '{"error":"Use a time like 23:00"}'; exit 0; }; done
	mkdir -p "${CRON%/*}"; touch "$CRON"
	grep -v 'sysx night' "$CRON" > "$RUN/cron.new"
	if [ "$en" = 1 ]; then
		oh="${off%:*}"; om="${off#*:}"; nh="${on%:*}"; nm="${on#*:}"
		echo "$((1$om-100)) $((1$oh-100)) * * * /usr/libexec/home-ui/sysx night off # Router Home: lights off" >> "$RUN/cron.new"
		echo "$((1$nm-100)) $((1$nh-100)) * * * /usr/libexec/home-ui/sysx night on # Router Home: lights on" >> "$RUN/cron.new"
	fi
	cp "$RUN/cron.new" "$CRON"; chmod 600 "$CRON"; rm -f "$RUN/cron.new"
	/etc/init.d/cron enable >/dev/null 2>&1; /etc/init.d/cron restart >/dev/null 2>&1
	echo '{"ok":true}'
	;;
*) sed -n '2,15p' "$0"; exit 1 ;;
esac
