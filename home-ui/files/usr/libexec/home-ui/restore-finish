#!/bin/sh
# Router Home: finish a full-backup restore. Started by the boot hook, again
# at every boot until it is done (/etc/init.d/home-ui-restore), and by the
# Continue button in Router Home.
#  1. put back files added by hand that the new firmware doesn't have
#  2. put back Router Home and apps that aren't in the OpenWrt feeds, unless
#     the new firmware already has the same or a newer version
#  3. wait for internet, install the feed apps (latest versions) and the
#     packages the non-feed apps need
#  4. switch services back on/off as they were, then restart once
# A copy of this script travels inside every full backup as finish.sh.

R=/etc/home-ui/restore
LOG=$R/log
umask 022
[ -d "$R" ] || exit 0
[ -f "$R/done" ] && exit 0
# only one at a time
[ -f /tmp/home-ui-restore.pid ] && kill -0 "$(cat /tmp/home-ui-restore.pid)" 2>/dev/null && exit 0
echo $$ > /tmp/home-ui-restore.pid

# keep coming back after a reboot until the restore is done
if [ ! -x /etc/init.d/home-ui-restore ]; then
	cat > /etc/init.d/home-ui-restore <<'INIT'
#!/bin/sh /etc/rc.common
# Router Home: continue an unfinished full-backup restore (removes itself when done)
START=99
start() {
	[ -f /etc/home-ui/restore/done ] && return 0
	f=/usr/libexec/home-ui/restore-finish
	[ -x "$f" ] || f=/etc/home-ui/restore/finish.sh
	[ -x "$f" ] && ( sleep 30; "$f" ) </dev/null >/dev/null 2>&1 &
}
INIT
	chmod 755 /etc/init.d/home-ui-restore
fi
/etc/init.d/home-ui-restore enabled 2>/dev/null || /etc/init.d/home-ui-restore enable 2>/dev/null

log() { echo "$(date '+%F %T') $*" >> "$LOG"; logger -t home-ui-restore "$*"; }
state() { echo "$1" > "$R/state"; [ -n "$2" ] && echo "$2" > "$R/message"; }

PM="$(cat "$R/pm" 2>/dev/null)"
command -v "$PM" >/dev/null 2>&1 || { command -v apk >/dev/null 2>&1 && PM=apk || PM=opkg; }

installed_version() {
	case $PM in
	apk)
		v="$(awk -v n="$1" '/^P:/{p=substr($0,3)} /^V:/{if(p==n){print substr($0,3); exit}}' /lib/apk/db/installed 2>/dev/null)"
		[ -n "$v" ] || { v="$(apk list -I "$1" 2>/dev/null | awk '{print $1; exit}')"; v="${v#"$1"-}"; }
		echo "$v" ;;
	opkg) awk -v n="$1" '/^Package:/{p=$2} /^Version:/{if(p==n){print $2; exit}}' /usr/lib/opkg/status ;;
	esac
}
# true when version $1 is newer than $2
newer() {
	[ -n "$2" ] || return 0
	[ "$1" = "$2" ] && return 1
	case $PM in
	apk) [ "$(apk version -t "$1" "$2" 2>/dev/null)" = ">" ] && return 0
	     [ -n "$(apk version -t "$1" "$2" 2>/dev/null)" ] && return 1 ;;
	opkg) opkg compare-versions "$1" '>>' "$2" 2>/dev/null; return $? ;;
	esac
	# fallback: plain version sort
	[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V 2>/dev/null | tail -1)" = "$1" ]
}
put_back() {	# staged dir; copies everything in it to /
	[ -d "$1" ] || return 0
	( cd "$1" && find . \( -type f -o -type l \) ) | while read -r f; do
		f="${f#.}"; mkdir -p "$(dirname "$f")"
		cp -a "$1$f" "$f" 2>/dev/null
	done
}
# internet = a default route, an answer from the internet, and a working
# name lookup; the package lists are refreshed afterwards, and one broken
# package source must not hold everything else back
online() {
	[ -n "$(ip route show default 2>/dev/null)$(ip -6 route show default 2>/dev/null)" ] || return 1
	ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1 || ping -c 1 -W 3 9.9.9.9 >/dev/null 2>&1 || return 1
	nslookup downloads.openwrt.org >/dev/null 2>&1 && return 0
	# the internet answers but names don't: the router's own DNS server may
	# not be there yet (AdGuard Home and others are among the apps being
	# reinstalled, with dnsmasq moved off port 53). Let the router itself
	# use the provider's and public DNS until the apps are back.
	dns_fallback && nslookup downloads.openwrt.org >/dev/null 2>&1
}
DNS_SAVED=""
dns_fallback() {
	[ -z "$DNS_SAVED" ] || return 0
	DNS_SAVED=/tmp/home-ui-resolv.conf.saved
	rm -f "$DNS_SAVED"; cp -P /tmp/resolv.conf "$DNS_SAVED" 2>/dev/null || : > "$DNS_SAVED"
	{
		grep -h '^nameserver' /tmp/resolv.conf.d/resolv.conf.auto /tmp/resolv.conf.auto 2>/dev/null | grep -vE ' (127\.|::1)' 
		printf 'nameserver 1.1.1.1\nnameserver 9.9.9.9\n'
	} | awk '!seen[$0]++' > /tmp/home-ui-resolv.conf
	rm -f /tmp/resolv.conf; cp /tmp/home-ui-resolv.conf /tmp/resolv.conf
	log "name lookups on the router did not work (its DNS server may be one of the apps to reinstall); using the provider's and public DNS for now"
}
dns_restore() {
	[ -n "$DNS_SAVED" ] && [ -e "$DNS_SAVED" -o -L "$DNS_SAVED" ] || return 0
	rm -f /tmp/resolv.conf; cp -P "$DNS_SAVED" /tmp/resolv.conf 2>/dev/null; rm -f "$DNS_SAVED" /tmp/home-ui-resolv.conf
}
# another apk/opkg (an update started by hand, LuCI, another app) holds the
# package database: wait for it instead of failing every app at once
pm_run() {
	local out rc i=0
	while :; do
		out="$("$@" 2>&1)"; rc=$?
		[ -n "$out" ] && printf '%s\n' "$out" >> "$LOG"
		[ $rc = 0 ] && return 0
		echo "$out" | grep -qiE 'lock|temporarily unavailable' || { PM_OUT="$out"; return $rc; }
		i=$((i + 1)); [ $i -ge 40 ] && { PM_OUT="$out"; return $rc; }
		[ $i = 1 ] && log "the package manager is busy (another install or update is running); waiting"
		sleep 15
	done
}
pm_update_once() {
	case $PM in
	apk) pm_run apk update ;;
	opkg) pm_run opkg update ;;
	esac
}
VPN_STOPPED=""
pm_update() {
	pm_update_once && return 0
	# "Operation not permitted": a VPN put back by the restore (signed out,
	# not connected yet) blocks the router's own traffic. Pause it while
	# the apps are installed.
	if echo "$PM_OUT" | grep -qi 'not permitted'; then
		for v in protonvpn; do
			[ -x "/etc/init.d/$v" ] || continue
			"/etc/init.d/$v" stop >/dev/null 2>&1 && VPN_STOPPED="$VPN_STOPPED $v"
		done
		if [ -n "$VPN_STOPPED" ]; then
			fw4 reload >/dev/null 2>&1; sleep 3
			log "downloads were blocked; paused$VPN_STOPPED while the apps are installed (sign in to it again afterwards if needed)"
			pm_update_once && return 0
		fi
	fi
	log "package list update had errors (continuing with the sources that worked): $(echo "$PM_OUT" | grep -iE 'error|fail|unable' | head -3 | tr '\n' ' ')"
	return 0
}
pm_add() {
	case $PM in
	apk) pm_run apk add "$1" ;;
	opkg) pm_run opkg install "$1" ;;
	esac
}

rm -f "$R/dismissed"
state running 'Putting back your files…'
log "restore started ($(head -1 "$R/created" 2>/dev/null))"
changed=0

# 1. files added by hand: only where the new firmware has nothing
if [ -d "$R/files/extra" ]; then
	( cd "$R/files/extra" && find . \( -type f -o -type l \) ) | while read -r f; do
		f="${f#.}"
		[ -e "$f" ] || [ -L "$f" ] && continue
		mkdir -p "$(dirname "$f")"; cp -a "$R/files/extra$f" "$f" 2>/dev/null
	done
	log "hand-added files put back"
fi

# 2a. Router Home
if [ -d "$R/files/home-ui" ]; then
	bv="$(cat "$R/homeui.ver" 2>/dev/null)"; cv="$(cat /usr/share/home-ui/version 2>/dev/null)"
	if [ -z "$cv" ] || newer "$bv" "$cv"; then
		put_back "$R/files/home-ui"; changed=1
		chmod 755 /usr/libexec/rpcd/home-ui /usr/libexec/home-ui/* /usr/sbin/home-ui-fan* /etc/init.d/home-ui-fan 2>/dev/null
		chmod -R a+rX /www/home /usr/share/home-ui 2>/dev/null
		log "Router Home $bv put back${cv:+ (firmware had $cv)}"
	else
		log "Router Home: kept the firmware's $cv (backup had $bv)"
	fi
fi

# 2b. apps that aren't in the feeds
while read -r n bv; do
	[ -n "$n" ] || continue
	cv="$(installed_version "$n")"
	if [ -z "$cv" ] || newer "$bv" "$cv"; then
		put_back "$R/files/pkg/$n"; changed=1
		log "$n $bv put back${cv:+ (firmware had $cv)}"
	else
		log "$n: kept the firmware's $cv (backup had $bv)"
	fi
done < "$R/nonfeed.txt"

# 3. feed apps, once the internet works (the restored network settings may
#    need the reboot that brought us here before they are up)
want="$(cat "$R/feed.txt" "$R/deps.txt" 2>/dev/null | sort -u)"
missing=""
for n in $want; do [ -n "$(installed_version "$n")" ] || missing="$missing $n"; done
if [ -n "$missing" ]; then
	state running "Waiting for internet to reinstall:$missing"
	tries=0
	until online; do
		tries=$((tries + 1))
		[ $tries = 1 ] && log "waiting for internet (checking every 30 seconds)"
		[ $tries -ge 120 ] && { state failed "No internet after an hour. Connect the router, then tap Continue. Apps not reinstalled yet:$missing"; log "gave up waiting for internet; will try again at the next restart or with Continue"; rm -f /tmp/home-ui-restore.pid; exit 1; }
		sleep 30
	done
	log "internet is up"
	state running "Reinstalling apps:$missing"
	pm_update
	failed=""
	for n in $missing; do
		if pm_add "$n"; then log "installed $n"; changed=1; else failed="$failed $n"; log "could not install $n"; fi
	done
	dns_restore
	for v in $VPN_STOPPED; do "/etc/init.d/$v" start >/dev/null 2>&1; done
fi

# 4. services as they were
while read -r s; do
	[ -x "/etc/init.d/$s" ] || continue
	"/etc/init.d/$s" enabled 2>/dev/null || { "/etc/init.d/$s" enable 2>/dev/null; changed=1; log "enabled $s"; }
done < "$R/services_on.txt"
while read -r s; do
	[ -x "/etc/init.d/$s" ] || continue
	# only turn off what the user had off; never the restore hook itself
	"/etc/init.d/$s" enabled 2>/dev/null && { "/etc/init.d/$s" disable 2>/dev/null; log "disabled $s"; }
done < "$R/services_off.txt"

# done: free the space, keep the log, restart once so everything starts clean
rm -rf "$R/files" "$R/finish.sh"
rm -f /lib/upgrade/keep.d/home-ui-restore
/etc/init.d/home-ui-restore disable 2>/dev/null; rm -f /etc/init.d/home-ui-restore
if [ -n "$failed" ]; then state done "Restored. Could not reinstall:$failed"
else state done 'Everything was restored'; fi
date > "$R/done"
log "restore finished${failed:+ (not reinstalled:$failed)}"
rm -f /tmp/home-ui-restore.pid
[ $changed = 1 ] && { sync; sleep 2; reboot; }
exit 0
