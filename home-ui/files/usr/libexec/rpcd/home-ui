	sysx)
		json_get_var action action
		X="$JOBS/sysx"
		case "$action" in
		stat|storage|tables|services|leds|pkg-list|pkg-upgradable|cron-get|night-get|tool-status) "$X" "$action" ;;
		tool)
			json_get_var t tool; json_get_var tg target; json_get_var c count; json_get_var six six
			[ "$six" = 1 ] && six=6 || six=""
			job_start tool "$X" tool "$t" "$tg" "$c" $six ;;
		service) json_get_var n name; json_get_var a trigger; "$X" service "$n" "$a" ;;
		cron-set)
			json_get_var tx text
			f="$RUN/cron.$$"; umask 077; printf '%s\n' "$tx" > "$f"
			"$X" cron-set "$f"; rm -f "$f" ;;
		pkg-search) json_get_var tx text; "$X" pkg-search "$tx" ;;
		pkg)
			json_get_var a trigger; json_get_var ns names
			case "$a" in install|remove|upgrade) [ -n "$ns" ] || { echo '{"error":"no package"}'; exit 0; } ;; update) ns="" ;; *) echo '{"error":"bad action"}'; exit 0 ;; esac
			if [ "$a" = remove ]; then
				for p in $ns; do case "$p" in base-files|busybox|kernel|libc|musl|procd|procd-*|ubus|ubusd|rpcd|rpcd-*|uhttpd|uhttpd-*|netifd|uci|libuci*|libubox*|libubus*|apk|apk-*|opkg|firewall4|fstools|fwtool|jshn|jsonfilter|logd|mtd|dnsmasq|dnsmasq-*|odhcpd*|nftables*|luci-base|cgi-io|home-ui|kmod-*|wpad*|hostapd*|urandom-seed|urngd|openwrt-keyring|ca-bundle)
					echo "{\"error\":\"$p is part of the router's core system and can't be removed here\"}"; exit 0 ;; esac; done
			fi
			job_start pkgx "$X" pkg "$a" $ns ;;
		pkg-status) job_state pkgx ;;
		led-set)
			json_get_var n name; json_get_var t trigger; json_get_var b brightness; json_get_var k persist
			"$X" led-set "$n" "$t" "$b" "$k" ;;
		night) json_get_var a trigger; case "$a" in on|off) "$X" night "$a" ;; *) echo '{"error":"bad"}' ;; esac ;;
		night-set) json_get_var e enabled; json_get_var off off; json_get_var on on; "$X" night-set "$e" "$off" "$on" ;;
		*) echo '{"error":"unknown action"}' ;;
		esac
		;;

	restart_service)
		json_get_var name name
		case "$name" in
			modemmanager|network|firewall|dnsmasq|tailscale|https-dns-proxy|cbe-led|sbe-led|status-led|miniupnpd|dropbear|uhttpd|adguardhome) ;;
			*) echo '{"error":"not allowed"}'; exit 0 ;;
		esac
		[ -x "/etc/init.d/$name" ] || { echo '{"error":"not installed"}'; exit 0; }
		( /etc/init.d/$name restart >/dev/null 2>&1 & ) </dev/null
		echo '{"ok":true}'
		;;

	*)
		echo '{"error":"unknown method"}'
		;;
	esac
	;;
esac
