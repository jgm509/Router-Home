		;;

	iot)
		json_get_var action action
		X="$JOBS/iot"
		case "$action" in
		info|remove|thread-dataset|thread-scan|ble-scan|thread-leave) "$X" "$action" ;;
		install) "$X" install /tmp/home-ui-iot.tar.gz ;;
		pair) job_start iotpair "$X" pair ;;
		pair-status) job_state iotpair ;;
		set)
			json_get_var en enabled; json_get_var bl ble
			[ -n "$en" ] && uci -q set home-ui-iot.main.enabled="$en"
			[ -n "$bl" ] && uci -q set home-ui-iot.main.ble="$bl"
			uci -q commit home-ui-iot
			"$X" apply ;;
		thread-form) json_get_var n name; "$X" thread-form "$n" ;;
		thread-join) json_get_var d dataset; "$X" thread-join "$d" ;;
		ble-adv) json_get_var o on; "$X" ble-adv "$([ "$o" = 1 ] && echo on || echo off)" ;;
		*) echo '{"error":"unknown action"}' ;;
		esac
