			f="$RUN/sms.$$"; umask 077; printf '%s\n%s' "$n" "$tx" > "$f"
			"$X" sms-send "$f"; rm -f "$f" ;;
		sms_delete) json_get_var i index; "$X" sms-delete "$i" ;;
