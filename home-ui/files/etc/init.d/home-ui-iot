#!/bin/sh /etc/rc.common
# Router Home: Thread border router and Bluetooth LE on the Askey radio
START=96
STOP=10
USE_PROCD=1
IOT=/usr/libexec/home-ui/iot

start_service() {
	config_load home-ui-iot
	local en ble
	config_get_bool en main enabled 0
	config_get_bool ble main ble 1
	[ "$en" = 1 ] || return 0
	{ [ -x /usr/lib/iotkit/bin/cpcd ] || command -v cpcd >/dev/null; } || return 0

	procd_open_instance cpcd
	procd_set_param command $IOT run-cpcd
	procd_set_param respawn 3600 5 10
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance otbr
	procd_set_param command $IOT run-otbr
	procd_set_param respawn 3600 10 0
	procd_close_instance

	[ "$ble" = 1 ] || return 0
	procd_open_instance ble
	procd_set_param command $IOT run-ble
	procd_set_param respawn 3600 10 0
	procd_close_instance
}

stop_service() {
	killall btattach cpc_hci_bridge 2>/dev/null
	return 0
}

service_triggers() {
	procd_add_reload_trigger home-ui-iot
}
