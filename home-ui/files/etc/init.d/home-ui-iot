#!/bin/sh /etc/rc.common
# Router Home: Thread, Bluetooth LE and Zigbee on the Askey radio
START=96
STOP=10
USE_PROCD=1
IOT=/usr/libexec/home-ui/iot

start_service() {
	local s
	# "iot services" knows the radio's firmware and what is installed:
	# cpcd (Silicon Labs firmware only), otbr, ble, zigbee
	for s in $($IOT services); do
		procd_open_instance "$s"
		procd_set_param command $IOT run-"$s"
		case "$s" in
		cpcd) procd_set_param respawn 3600 5 10; procd_set_param stderr 1 ;;
		*) procd_set_param respawn 3600 10 0 ;;
		esac
		procd_close_instance
	done
}

stop_service() {
	killall btattach cpc_hci_bridge cpc-hci-bridge 2>/dev/null
	return 0
}

service_triggers() {
	procd_add_reload_trigger home-ui-iot
}
