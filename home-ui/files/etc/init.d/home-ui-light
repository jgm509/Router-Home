#!/bin/sh /etc/rc.common
# Router Home status light (any router; off until turned on in Router Home)

START=99
USE_PROCD=1

start_service() {
	config_load home-ui-light
	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/home-ui-light
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger home-ui-light
}
