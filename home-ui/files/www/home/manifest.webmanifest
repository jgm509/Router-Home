{
	"name": "Router Home",
	"short_name": "Router",
	"description": "Your router: internet status, devices, WiFi, mobile and settings.",
	"id": "/home/",
	"start_url": "/home/",
	"scope": "/home/",
	"display": "standalone",
	"background_color": "#0c1520",
	"theme_color": "#0c1520",
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
		{ "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	],
	"shortcuts": [
		{ "name": "Devices", "url": "/home/#/devices", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "WiFi", "url": "/home/#/wifi", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
	]
}
