config led 'main'
	option enabled '1'
	# brightness 1-255
	option brightness '96'
	# green is much brighter than red and blue on this LED: the stock
	# firmware drives it at about 18 %. Percent of the other colours.
	option green_balance '18'
	# hosts used to test internet access
	list check_host '1.1.1.1'
	list check_host '8.8.8.8'
	# seconds between checks
	option interval '15'
	# interfaces that count as a mobile modem (white); anything else is WAN (blue)
	option modem_devices 'wwan* mhi_* wwp* usb* rmnet*'
