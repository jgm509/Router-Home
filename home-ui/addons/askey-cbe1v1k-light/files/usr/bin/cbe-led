#!/bin/sh
# cbe-led: control the Askey CBE1V1K front LED (Awinic AW210xx at i2c-0, 0x20)
# Register sequences taken from the stock aw210xx driver's group tables.
# Usage: cbe-led <off|white|red|green|blue|yellow|cyan|magenta|breath> [level 0-255]

BUS=0
ADDR=0x20
LVL=$(printf '0x%02x' "${2:-96}")

w() { i2cset -y $BUS $ADDR "$1" "$2" || exit 1; }

# r g b = per-color group levels (0x88 0x89 0x8a)
solid() {
	w 0x20 0x01        # chip enable
	w 0x58 0x60        # global current
	w 0x80 0x00        # pattern mode off
	w 0x81 0x00
	w 0x8b 0x07        # group enable
	w 0x88 "$1"        # red
	w 0x89 "$2"        # green
	w 0x8a "$3"        # blue
	w 0x86 "$LVL"      # group brightness
	w 0x87 "$LVL"
	w 0x45 0x00        # apply
}

case "$1" in
	off)     w 0x20 0x00 ;;
	white)   solid 0x60 0x60 0x60 ;;
	red)     solid 0x60 0x00 0x00 ;;
	green)   solid 0x00 0x60 0x00 ;;
	blue)    solid 0x00 0x00 0x60 ;;
	yellow)  solid 0x60 0x60 0x00 ;;
	cyan)    solid 0x00 0x60 0x60 ;;
	magenta) solid 0x60 0x00 0x60 ;;
	breath)  # stock "breath" table (white)
		for rv in 0x20:0x01 0x58:0x60 0x80:0x03 0x8b:0x07 0x88:0x60 0x89:0x60 \
			  0x8a:0x60 0x86:0x60 0x87:0x00 0x82:0xaa 0x83:0xaa 0x84:0x00 \
			  0x85:0x00 0x81:0x01; do
			w "${rv%%:*}" "${rv##*:}"
		done ;;
	*) echo "usage: $0 <off|white|red|green|blue|yellow|cyan|magenta|breath> [level 0-255]"; exit 1 ;;
esac
