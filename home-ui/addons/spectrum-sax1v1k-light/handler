#!/bin/sh
# Router Home add-on handler: Spectrum SAX1V1K front light (RGB, on/off)
#   handler led info | set | test   (JSON on stdin)
# Never calls /etc/init.d: the status service picks up both the on/off
# setting and the colour test by itself, so a request can never block.
. /usr/share/libubox/jshn.sh
json_load "$(cat)"

HOLD=/var/run/sax-led.hold

case "$1 $2" in
"led info")
	en=true; [ "$(uci -q get sax-led.main.enabled)" = 0 ] && en=false
	cat <<J
{"enabled":$en,"brightness":null,
 "description":"Blue: WAN · white: mobile modem · yellow: no internet · red: offline",
 "colors":[{"id":"blue","label":"WAN","css":"#3b7cff"},{"id":"white","label":"Mobile","css":"#f2f5f8"},
  {"id":"yellow","label":"No internet","css":"#f0b429"},{"id":"red","label":"Offline","css":"#ff4d55"},
  {"id":"green","label":"Green","css":"#2fbf71"},{"id":"cyan","label":"Cyan","css":"#2ad4e0"},
  {"id":"magenta","label":"Magenta","css":"#d24dff"},
  {"id":"breath","label":"Starting","css":"linear-gradient(#3b7cff,#0b2a5e)"}]}
J
	;;
"led set")
	json_get_var enabled enabled
	[ "$enabled" = 1 ] || enabled=0
	uci -q set sax-led.main=led
	uci -q set sax-led.main.enabled="$enabled"
	uci -q commit sax-led
	rm -f "$HOLD"
	[ "$enabled" = 0 ] && /usr/bin/sax-led off >/dev/null 2>&1
	echo '{"ok":true}'
	;;
"led test")
	json_get_var color color
	case "$color" in white|red|green|blue|yellow|cyan|magenta|breath|off) ;; *) color=white ;; esac
	u="$(cat /proc/uptime 2>/dev/null)"; u="${u%%.*}"
	echo $(( ${u:-0} + 5 )) > "$HOLD" 2>/dev/null
	/usr/bin/sax-led "$color" >/dev/null 2>&1
	echo '{"ok":true}'
	;;
*)
	echo '{"error":"not supported"}' ;;
esac
