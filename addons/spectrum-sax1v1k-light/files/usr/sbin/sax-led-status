#!/bin/sh
# Show router status on the SAX1V1K front LED.
#   blue    = internet OK through the WAN port
#   white   = internet OK through a mobile modem
#   yellow  = uplink up (default route) but internet unreachable
#   red     = no uplink at all
# The light is switched off while sax-led.main.enabled is 0, and left
# alone while a colour test holds it (see HOLD below).

. /lib/functions.sh

config_load sax-led
config_get INTERVAL main interval 15
config_get MODEM_DEVS main modem_devices "wwan* mhi_* wwp* usb* rmnet*"
HOSTS=""
add_host() { HOSTS="$HOSTS $1"; }
config_list_foreach main check_host add_host
[ -n "$HOSTS" ] || HOSTS="1.1.1.1 8.8.8.8"
case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=15 ;; esac

HOLD=/var/run/sax-led.hold

now() { local u; u="$(cat /proc/uptime 2>/dev/null)"; u="${u%%.*}"; echo "${u:-0}"; }

last=""
set_state() {
	[ "$1" = "$last" ] && return
	/usr/bin/sax-led "$1" >/dev/null 2>&1 && last="$1"
	logger -t sax-led "status: $1${2:+ ($2)}"
}

# device the router would use to reach the internet right now
uplink_dev() {
	ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1
}

is_modem() {
	for p in $MODEM_DEVS; do
		case "$1" in $p) return 0 ;; esac
	done
	return 1
}

online() {
	for h in $HOSTS; do
		ping -c 1 -W 3 "$h" >/dev/null 2>&1 && return 0
	done
	return 1
}

trap 'exit 0' TERM INT
next=0
while :; do
	n="$(now)"

	# a colour test holds the light for a few seconds
	if [ -f "$HOLD" ] && [ "$(cat "$HOLD" 2>/dev/null || echo 0)" -gt "$n" ] 2>/dev/null; then
		last=""; next=0
		sleep 1
		continue
	fi

	if [ "$(uci -q get sax-led.main.enabled)" = 0 ]; then
		set_state off
		sleep 2
		continue
	fi

	if [ "$n" -ge "$next" ]; then
		next=$((n + INTERVAL))
		dev=""
		[ -n "$(ip route show default 2>/dev/null)" ] && dev="$(uplink_dev)"
		if [ -z "$dev" ]; then
			set_state red
		elif ! online; then
			set_state yellow "$dev"
		elif is_modem "$dev"; then
			set_state white "$dev"
		else
			set_state blue "$dev"
		fi
	fi
	sleep 2
done
