#!/bin/sh /etc/rc.common
# Front LED status for Askey CBE1V1K

START=19
STOP=90
USE_PROCD=1

boot() {
	# early: show "booting" right away
	/usr/bin/cbe-led breath >/dev/null 2>&1
	start "$@"
}

start_service() {
	config_load cbe-led
	local enabled
	config_get_bool enabled main enabled 1
	if [ "$enabled" -eq 0 ]; then
		/usr/bin/cbe-led off >/dev/null 2>&1
		return 0
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/cbe-led-status
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/bin/cbe-led off >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger cbe-led
}
